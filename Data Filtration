# Load packages 
library(CMplot)
library(tidyverse)
library(ggplot2)

# Clear global environment, set working directory, and set seed
rm(list = ls())
setwd("/home/bio.aau.dk/vm82rp/students/f26/BT_6_7")  
set.seed(1)

# Load genotype and SNP data
load("data/MASPOT_F1_gt.RData")   
load("data/snppos.RData")         # SNP positions
SNP <- snppos

# Remove the columns marker, chrom, and pos
Geno_mat <- as.matrix(MASPOT_F1_gt[,-(1:3)])  # kun genotyper
# Transform the matrix
Geno_mat <- t(Geno_mat)  # rækker = individer, kolonner = SNPs

# Check dimension and structure 
dim(Geno_mat)
str(Geno_mat)

# Load phenotype data
load("data/MASPOT_RST_pt.RData")  

# Check structure and summary 
str(MASPOT_RST_pt)
summary(MASPOT_RST_pt) 

# Match phenotype to genotype based on SOR
match_idx <- match(rownames(Geno_mat), MASPOT_RST_pt$SOR)
pheno_full <- MASPOT_RST_pt[match_idx, ]


###############################################
#     Filtering data based on NA-entries 
###############################################

# Remove individuals with missing phenotype scores
index <- !is.na(pheno_full$RST) 
pheno_use <- pheno_full[index, ] 
Geno_use  <- Geno_mat[index, ] 

# Check dimensions of phenotype- and genotype data, and whether their rows match
dim(pheno_use)
dim(Geno_use)
all(rownames(Geno_use) == pheno_use$SOR) # Should say TRUE

# Calculate missing entries for genotype
total_entries <- nrow(Geno_use) * ncol(Geno_use)
total_NA <- sum(is.na(Geno_use)) 
pct_missing <- 100 * total_NA / total_entries 
cat("Total missing genotypes:", total_NA, "\n")
cat("Percentage of missing genotype:", round(pct_missing, 2), "%\n")

# Missingness for each SNP (columns)
snp_missing <- colMeans(is.na(Geno_use)) * 100
# Missingness for each individual (rows)
ind_missing <- rowMeans(is.na(Geno_use)) * 100

# Check summary of missing SNPs and individuals
summary(snp_missing)
summary(ind_missing)

# Filter out SNPs with a missingness > 50%
Geno_snp_filt <- Geno_use[, colMeans(is.na(Geno_use)) < 0.5]
sum(is.na(Geno_snp_filt))  # NA entries left

# Check...
ncol(Geno_use) # SNPs before filtering
ncol(Geno_snp_filt) # SNPs post-filtering 
sum(colMeans(is.na(Geno_use[, -1])) >= 0.5) # How many SNPs were removed 
max(colMeans(is.na(Geno_snp_filt))) # Must be < 0.5, checking max missingness per SNP
any(colMeans(is.na(Geno_snp_filt[, -1])) >= 0.5) # Must be FALSE

# Filter out individuals with missingness > 70%
Geno_ind_filt <- Geno_snp_filt[rowMeans(is.na(Geno_snp_filt)) < 0.7, ] 
pheno_filtered <- pheno_use[rowMeans(is.na(Geno_snp_filt)) < 0.7, ]

# Check dimensions of phenotype- and genotype data, and whether their rows match
dim(pheno_filtered) 
dim(Geno_ind_filt) 
nrow(Geno_ind_filt) == nrow(pheno_filtered)  # Must be TRUE
sum(colMeans(is.na(Geno_use[, -1])) >= 0.5) # How many SNPs were removed 

###############################################
#     Filtering SNPs with MAF < 1%  
###############################################

# Removing SNPs with MAF < 1%
p <- colSums(Geno_ind_filt, na.rm = TRUE) / (4 * nrow(Geno_ind_filt))
maf = ifelse(p > 0.5, 1 - p, p)
Geno_maf <- Geno_ind_filt[ ,!(maf <= 0.01)] 

# Check... 
ncol(Geno_ind_filt) # SNPs before filtering
ncol(Geno_maf) # SNPs post-filtering 
perc_missing <- (sum(is.na(Geno_maf))/((ncol(Geno_maf))*nrow(Geno_maf)))*100 # %-missing genotype
cat("Percentage of missing genotype:", round(perc_missing, 2), "%\n")


###############################################
#     Mean imputation of genotypes
###############################################

# Replace missing SNP values with a mean
Geno_imp <- apply(Geno_maf, 2, function(col) {
  ifelse(is.na(col), mean(col, na.rm = TRUE), col)
  })

# Check summary and dimension
sum(is.na(Geno_imp))  # Must be zero
dim(Geno_imp)

# Make a genotype distribution plot
SNP_maf <- SNP
colnames(SNP_maf) <- c("marker", "chrom", "pos")
SNP_maf <- SNP_maf[match(colnames(Geno_maf), SNP_maf$marker), ]
SNP_maf$chrom <- as.numeric(as.factor(SNP_maf$chrom))

CMplot(SNP_maf,plot.type="d",bin.size=1e6,chr.den.col=c("darkgreen", "yellow", "red"),file="jpg",file.name="SNP_density3.0", dpi=300,
       main="SNP density, 1 Mb window",file.output=TRUE,verbose=TRUE,width=9,height=6)

# Check...
all(SNP_maf$marker == colnames(Geno_maf))  # Must be TRUE
sum(is.na(SNP_maf$marker))                # Must be 0 


##########################################################
#     Prepare phenotype- and genotype data for PCA and GWAS
##########################################################

# Genotype file for PCA
geno_final_PCA <- round(Geno_imp) # Round genotypes

# Genotype file for GWAS
geno_m <- t(Geno_imp) 
SNP_final <- SNP_maf[match(rownames(geno_m), SNP_maf$marker), ]
geno_final_GWAS <- cbind(SNP_final, round(geno_m))

# Phenotype file
pheno_final <- pheno_filtered
rownames(pheno_final) <- pheno_final$SOR

save(geno_final_PCA, file = "results/geno_final_PCA.RData")
save(geno_final_GWAS, file = "results/geno_final_GWAS2.RData")
save(SNP_final,  file = "results/SNP_final.RData")
save(pheno_final, file = "results/pheno_final.RData")
save(pheno_use, file = "results/pheno_use.RData")
