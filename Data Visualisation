### Figure 4.2.b Boxplots of the MASPOT panel's late blight resistance scores categorised by cytoplasm ###

ggplot(pheno_final, aes(x = reorder(Cytoplasm, RST, FUN = median), y = RST)) + 
  geom_boxplot(fill = "#f2faf3") + 
