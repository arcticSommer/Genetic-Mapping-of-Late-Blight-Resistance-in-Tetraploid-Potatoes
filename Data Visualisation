  labs(x = "Cytoplasm", y = "Late blight res. [1-9]") +
  scale_y_continuous(breaks = 1:9) +
  coord_cartesian(ylim = c(1, 10.5)) +
  theme_custom() +
  theme(axis.text.x = element_text(size = 20, angle = 90, vjust = 0.5, hjust = 1), axis.title.x = element_text(size = 25),  axis.text.y = element_text(size = 20),
        axis.title.y = element_text(size = 26))

ggsave("plots/boxplots_RST_cytoplasm.png", width = 10, height = 5)


### Figure 4.3 One-way ANOVA and post-hoc Tukey's test ###

# ANOVA
fit_cytoplasm <- aov(RST ~ Cytoplasm, data = pheno_final)
summary(fit_cytoplasm)

# Posthoc Tukey test 
tukey_results <- TukeyHSD(fit_cytoplasm)
print(tukey_results)

# Plot the results 
tukey <- as.data.frame(tukey_results$Cytoplasm) 
tukey <- mutate(tukey, comparison = rownames(tukey))

ggplot(tukey, aes(x = diff, y = comparison)) +
  geom_point(shape = 3, size = 3) +
  geom_errorbar( aes(xmin = lwr, xmax = upr), orientation = "y", width = 0.2) +
  geom_vline(xintercept = 0, linetype = "dashed", color = "grey40") +
  labs( x = "Differences in mean late blight res. [1-9]", y = NULL) +
  theme_custom()

ggsave("plots/anova_tukey_cytoplasm.png", width = 6, height = 3)


