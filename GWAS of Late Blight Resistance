##############################################
#     Setup theme
##############################################

theme_custom <- function() {
  theme_few() +
    theme(
      # Text
      text = element_text(family = "serif", size = 12),
      plot.title = element_text(
        hjust = 0.5,
        size = 16,
        face = "bold"
      ),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      plot.caption = element_text(size = 10),
      
      # Axes
      axis.title = element_text(size = 13),
      axis.text = element_text(size = 11),
      
      # Legend
      legend.title = element_text(size = 12, face = "bold"),
      legend.text = element_text(size = 11),
      legend.background = element_blank(),
      
      # Grid lines
      panel.grid.major = element_line(color = "grey85", linewidth = 0.3),
      panel.grid.minor = element_line(color = "grey93", linewidth = 0.2),
      
      # Background and frame
      panel.background = element_rect(fill = "white", color = NA),
      panel.border = element_blank(),
      
      # Margins
      plot.margin = margin(10, 10, 10, 10)
    )
}


##############################################
#     GWAS using GWASpoly 
##############################################

# Formatting R files to CSV format
write.csv(pheno_final_GWAS, "pheno.csv", row.names = FALSE)
write.csv(geno_final_GWAS, "geno.csv", row.names = FALSE)

# Read data
data <- read.GWASpoly(ploidy = 4,
                      pheno.file = "pheno.csv",
                      geno.file = "geno.csv",
                      format = "numeric",
                      n.traits = 1,
                      delim = ",")

# Create LOCO GRMs
data.loco <- set.K(data, LOCO = TRUE)

# Population size
N <- ncol(geno_final_GWAS) - 3 

# Set params to specify fixed effects
params <- set.params(geno.freq = 1 - 5/N,
                     fixed = "Cytoplasm",
                     fixed.type = "factor",
                     n.PC = 3)

# Testing markers for significance - GWASpoly conducts the hypothesis tests for each marker
data.loco.scan <- GWASpoly(data = data.loco,
                           models = c("additive", "1-dom"),
                           traits = c("RST"),
                           params = params,
                           n.core = 1)
save(data.loco.scan, file =  "results/data.loco.scan.RData")


# Q-Q plot of the observed vs. expected p-values
png(filename = "plots/qqplot_GWAS.png", width = 1000, height = 500)
qq.plot(data.loco.scan, trait = "RST")
dev.off()

# Setting the Bonferroni threshold
data2 <- set.threshold(data.loco.scan,
                       method="Bonferroni",
                       level=0.05)


########################################################
#     Calculating partial R^2 for the QTLs using GWASpoly
########################################################

# QTLs for the additive model
qtl_additive <- get.QTL(data=data2, 
               traits="RST",
               models="additive",
               bp.window=5e6)
               
# Partial R^2 for the additive model
fit.ans.additive <- fit.QTL(data=data2,trait="RST",
                           qtl=qtl_additive[,c("Marker","Model")],
                           fixed=data.frame(Effect="Cytoplasm",Type="factor"))
save(fit.ans.additive, file = "results/R2_additive_QTLs.RData")


# QTLs for the 1-dom-alt
qtl_1.dom.alt <- get.QTL(data=data2, 
               traits="RST",
               models="1-dom-alt",
               bp.window=5e6)

# Partial R^2 for 1-dom-alt
fit.ans.1.dom.alt <- fit.QTL(data=data2,trait="RST",
                  qtl=qtl_1.dom.alt[,c("Marker","Model")],
                  fixed=data.frame(Effect="Cytoplasm",Type="factor"))
save(fit.ans.1.dom.alt, file = "results/R2_1.dom.alt_QTLs.RData")


# QTL for the 1-dom-ref
qtl_1.dom.ref <- get.QTL(data=data2, 
                         traits="RST",
                         models="1-dom-ref",
                         bp.window=5e6)

# Partial R^2 for the 1-dom-ref
fit.ans.1.dom.ref <- fit.QTL(data=data2,trait="RST",
                            qtl=qtl_1.dom.ref[,c("Marker","Model")],
                            fixed=data.frame(Effect="Cytoplasm",Type="factor"))
save(fit.ans.1.dom.ref, file = "results/R2_1.dom.ref_QTLs.RData")


##############################################
#     Genomic Inflation Factor ADDITIVE MODEL
##############################################

results <- data.frame(data.loco.scan@scores)
results$Marker <- rownames(results)
results$p.addi <- 10^(-results$RST.additive) 

map <- data.frame(data.loco.scan@map)

# If markers have missing values, remove them 
bad_markers <- results$Marker[is.na(results$RST.additive)]

if (length(bad_markers) > 0) {
  results <- results[!results$Marker %in% bad_markers, ]
  map <- map[!map$Marker %in% bad_markers, ]
}


# QQ plot of -log10(p) to evaluate for bias before correction  

pvals <- sort(results$p.addi)
pvals <- pvals[pvals > 0]
expected <- ppoints(length(pvals))

qq_df <- data.frame(
  observed = -log10(pvals),
  expected = -log10(expected)
)

png(filename = "plots/qqplot_inflation_additive_model.png", width = 1000, height = 500)
ggplot(qq_df, aes(expected, observed)) +
  geom_point(size = 1) +
  geom_abline(slope = 1, intercept = 0, color = "seagreen") +
  labs(x = expression(Expected~~-log[10](p)),
       y = expression(Observed~~-log[10](p))) +
  coord_cartesian(xlim = c(0, 6), ylim = c(0, 20)) +
  theme_custom()
dev.off()


# Calculate genomic inflation factor from p-values
chisq <- qchisq(results$p, 1, lower.tail = FALSE) # convert p-values to chi-square values
lambda <- median(chisq)/qchisq(0.5,1) # calculate the genomic inflation factor 
save(lambda, file = "results/lambda_additive.RData")
#Lambda = 1.115

# Correct p-values
corr.chisq <- chisq/lambda # correct the chi-square values 
results$Pcorr <- pchisq(corr.chisq, df = 1, lower.tail = FALSE) 
results_corr <- left_join(results, map, by = "Marker")
results_corr$Chrom <- as.numeric(as.character(results_corr$Chrom))

save(results_corr, file = "results/pcorr_additive_model.RData")


# QQ plot of -log10(pcorr) to control bias correction 

pvals <- sort(results$Pcorr)
pvals <- pvals[pvals > 0]
expected <- ppoints(length(pvals))

qq_df <- data.frame(
  observed = -log10(pvals),
  expected = -log10(expected)
)

png(filename = "plots/qqplot_inflation_additive_model_corr.png")
ggplot(qq_df, aes(expected, observed)) +
  geom_point(size = 1) +
  geom_abline(slope = 1, intercept = 0, color = "seagreen") +
  labs(x = expression(Expected~~-log[10](p)),
       y = expression(Observed~~-log[10](p))) +
  coord_cartesian(xlim = c(0, 6), ylim = c(0, 20)) +
  theme_custom()
dev.off()


# Manhattan plot of corrected p-values

bonferroni <- 0.05 / nrow(results) # Threshold

png(file = "plots/manhattan_additive_model_pcorr.png", width = 1000, height = 400)
par(family = "serif",
    mar = c(5, 6, 4, 2))
qqman::manhattan(
  results_corr,
  chr = "Chrom",
  bp = "Position",
  snp = "Marker",
  p = "Pcorr",
  suggestiveline = FALSE,
  genomewideline = FALSE,
  col = c("#94b5a0", "seagreen"),
  main = "Late blight resistance - Additive model",
  ylim = c(0, 20),
  cex.lab = 1.6,
  cex.axis = 1.4,
  cex.main = 1.6
)
abline(h = -log10(bonferroni), col = "grey30") 
dev.off()

# Significant SNPs for the additive model
snp_select_bonferroni_additive <- results_corr[results_corr$Pcorr < bonferroni, ] 
save(snp_select_bonferroni_additive, file = "results/significant_snps_additive.RData")


