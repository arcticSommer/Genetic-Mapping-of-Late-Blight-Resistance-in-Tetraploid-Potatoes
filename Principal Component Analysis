##############################################
#     Setup theme
##############################################

theme_custom <- function() {
  theme_few() +
    theme(
      # Text
      text = element_text(family = "serif", size = 12),
      plot.title = element_text(
        hjust = 0.5,
        size = 16,
        face = "bold"
      ),
      plot.subtitle = element_text(hjust = 0.5, size = 12),
      plot.caption = element_text(size = 10),
      
      # Axes
      axis.title = element_text(size = 13),
      axis.text = element_text(size = 11),
      
      # Legend
      legend.title = element_text(size = 12, face = "bold"),
      legend.text = element_text(size = 11),
      legend.background = element_blank(),
      
      # Grid lines
      panel.grid.major = element_line(color = "grey85", linewidth = 0.3),
      panel.grid.minor = element_line(color = "grey93", linewidth = 0.2),
      
      # Background and frame
      panel.background = element_rect(fill = "white", color = NA),
      panel.border = element_blank(),
      
      # Margins
      plot.margin = margin(10, 10, 10, 10)
    )
}


##############################################
#     Population structure analysis
##############################################

# Calculation of genomic relationship matrix (GRM)
G <- Gmatrix(geno_final_PCA, ploidy = 4, ploidy.correction = TRUE) # realized additive relationship matrix
dim(G)
table(rownames(G) == rownames(pheno_final))

# Create a heatmap of the GRM to visualize population structure
png(filename = "plots/PCA_heatmap.png", width = 800, height = 800)
heatmap(G, labRow = FALSE, labCol = FALSE) 
dev.off()

# Perform PCA analysis of the GRM
pca_G <- prcomp(G)

# Compute eigenvalues and variance
eig <- (pca_G$sdev)^2 
variance <- eig*100/sum(eig) 
head(variance) 

# Connect each variance with corresponding PC
var_G <- data.frame("variance" = variance, 
                    "PC" = c(1:nrow(pheno_final)))

# Save scores and loadings (x and rotation)
scores <- data.frame(sample.id = pheno_final$SOR, pca_G$x) 
head(scores[ ,1:4]) 
loadings <- as.data.frame(pca_G$rotation) 
head(loadings[ ,1:4])

# Plot the explained variance of the first 20 PCs
variance_plot <- ggplot(data = subset(var_G, PC <= 20), aes(x = PC, y = variance)) +
  geom_bar(stat = "identity", fill = "seagreen") + 
  labs(x = "Principal component", y = "Variance explained [%]") +
  theme_custom() 
plot(variance_plot) 
ggsave("plots/PCA_variance.png", width = 8, height = 4)


