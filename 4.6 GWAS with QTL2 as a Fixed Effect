# Create LOCO GRMs
data.loco <- set.K(data, LOCO=TRUE)

# Population size
N <- ncol(geno_final_GWAS_filt) - 3 # Population size

# Set params to specify fixed effects
params <- set.params(geno.freq = 1 - 5/N,
                     fixed = c("Cytoplasm","SNP_chr5_4839577"),
                     fixed.type = c("factor","factor"),
                     n.PC = 3)

# Testing markers for significance - GWASpoly conducts the hypothesis tests for each marker
data.loco.scan <- GWASpoly(data = data.loco,
                           models = c("1-dom"),
                           traits = c("RST"),
                           params = params)
save(data.loco.scan, file = "results/data.loco.scan_chr5_4839577.Rdata")


# Setting the Bonferroni threshold
data2 <- set.threshold(data.loco.scan,
                       method="Bonferroni",
