## Result when including chr5_4091093 and chr5_4814697 as fixed effect: No significant SNPs are observed, all p-values are under the threshold line. 


## Manhattan plot used in the project

results.additive <- data.frame(data.loco.scan@scores)
results.additive$Marker <- rownames(results.additive)
results.additive$p.value <- 10^(-results.additive$additive) 

map <- data.frame(data.loco.scan@map)

# If markers have NA in the additive model, remove it from both results and map 
bad_markers <- results.additive$Marker[is.na(results.additive$additive)]

if (length(bad_markers) > 0) {
  results.additive <- results.additive[!results.additive$Marker %in% bad_markers, ]
  map <- map[!map$Marker %in% bad_markers, ]
}

results.additive <- left_join(results.additive, map, by = "Marker")
results.additive$Chrom <- as.numeric(as.character(results.additive$Chrom))
save(results.additive, file = "results/results.additive_chr5_4091093_chr5_4814697.RData")

bonferroni <- 0.05 / nrow(results.additive)

png(file = "plots/qqman_manhattan_chr5_4091093_chr5_4814697_fixed_additive.png", width = 1000, height = 400)
par(family = "serif",
    mar = c(5, 6, 4, 2))
qqman::manhattan(
  results.additive,
  chr = "Chrom",
  bp = "Position",
  snp = "Marker",
  p = "p.value",
  suggestiveline = FALSE,
  genomewideline = FALSE,
  col = c("#94b5a0", "seagreen"),
  main = paste0("Late blight resistance - Additive model, QTL2 fixed"), 
  ylim = c(0,20),
  cex.lab = 1.6,
  cex.axis = 1.4,
  cex.main = 1.6
)
abline(h = -log10(bonferroni), col = "grey30")
dev.off()



