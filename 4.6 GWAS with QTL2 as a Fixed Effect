## Result when including chr5_4091093 as a fixed effect: one significant SNP chr08_1068766 

# Partial R^2 for 1-dom-ref chr08_1068766
fit.ans <- fit.QTL(data = data2,
                   trait="RST",
                   qtl=qtl[,c("Marker","Model")],
                   fixed=data.frame(Effect="Cytoplasm","SNP_chr5_4839577",
                                    Type="factor", "factor"))
save(fit.ans, file = "results/R2_1.dom.ref_chr8_1068766.Rdata")


## Genomic inflation factor and manhattan plot used in the project

results <- data.frame(data.loco.scan@scores)
results$Marker <- rownames(results)
results$p.dom.ref <- 10^(-results$RST.1.dom.ref) 

map <- data.frame(data.loco.scan@map)

# If markers have NA in 1.dom.ref, remove it from both results and map 
bad_markers <- results$Marker[is.na(results$RST.1.dom.ref)]

if (length(bad_markers) > 0) {
  results <- results[!results$Marker %in% bad_markers, ]
  map <- map[!map$Marker %in% bad_markers, ]
}

# Calculate genomic inflation factor from p-values
chisq <- qchisq(results$p, 1, lower.tail = FALSE) # convert p-values to chi-square values
lambda <- median(chisq)/qchisq(0.5,1) # calculate the genomic inflation factor 
save(lambda, file = "results/lambda_chr5_4839577.fixed.RData")
#Lambda = 1.05

# Correct p-values
corr.chisq <- chisq/lambda # correct the chi-square values 
results$Pcorr <- pchisq(corr.chisq, df = 1, lower.tail = FALSE) 
results_corr <- left_join(results, map, by = "Marker")
results_corr$Chrom <- as.numeric(as.character(results_corr$Chrom))

save(results_corr, file = "results/pcorr_chr5_4839577.fixed.RData")


# Manhattan plot of corrected p-values

bonferroni <- 0.05 / nrow(results) # Threshold

png(file = "plots/qqman_manhattan_chr5_4839577_fixed_1.dom.ref.png", width = 1000, height = 400)
par(family = "serif",
    mar = c(5, 6, 4, 2))
qqman::manhattan(
  results_corr,
  chr = "Chrom",
  bp = "Position",
  snp = "Marker",
  p = "Pcorr",
  suggestiveline = FALSE,
  genomewideline = FALSE,
  col = c("#94b5a0", "seagreen"),
  main = paste0("Late blight resistance - 1-dom-ref, QTL2 fixed"),
  ylim = c(0,20),
  cex.lab = 1.6,
  cex.axis = 1.4,
  cex.main = 1.6
)
abline(h = -log10(bonferroni), col = "grey30")
dev.off()

# Significant SNP for 1.dom.ref = chr08_1068766
snp_select_bonferroni <- results_corr[results_corr$Pcorr < bonferroni, ] 
save(snp_select_bonferroni, file = "results/significant_snp_chr8_1068766_1.dom.ref.RData")


###################################################
#     MAF for SNP chr8_1068766
###################################################

remove_marker <- c("chr08_1068766")
SNP.lead <- filter(geno_final_GWAS, marker %in% remove_marker)
SNP.lead.re <- SNP.lead[, -(1:3)]

p <- rowSums(SNP.lead.re, na.rm = TRUE)/(4 * ncol(SNP.lead.re)) 
maf = ifelse(p > 0.5, 1 - p, p)

maf_matrix <- cbind(remove_marker, maf)
colnames(maf_matrix) <- c("SNP pos", "MAF")

save(maf_matrix, file = "results/maf_cytoplasm_chr8_1068766_fixed.Rdata")


