#######################################################
# ADDITIVE MODEL: Lead SNP chr5_4091093 as fixed effect
#######################################################

# Load genotype and phenotype data
load("results/geno_final_GWAS.RData")
load("results/pheno_final.RData")

# Remove columns "Mother" and "Father"
pheno_final_GWAS <- pheno_final[,-(2:3)] 

# Swap Cytoplasm and RST columns, to make Cytoplasm the fixed effect in GWASpoly
pheno_final_GWAS <- pheno_final_GWAS[c(1,3,2)]

# Take out the SNP that is wanted as fixed effect, remove it from the genotype data
remove_marker <- c("chr05_4091093")
SNP.lead <- filter(geno_final_GWAS, marker %in% remove_marker)
geno_final_GWAS_filt <- geno_final_GWAS[!geno_final_GWAS$marker %in% remove_marker, ]

# Add the SNP to the phenotype data to run it as a fixed effect in GWASpoly
SNP.lead <- SNP.lead[,-(1:3)]
SNP.lead.t <- t(SNP.lead)
pheno_final_GWAS$SNP_chr5_4091093 <- SNP.lead.t[,1][pheno_final_GWAS$SOR]


## Conduct GWASpoly 

#Formatting R files to CSV format:
write.csv(pheno_final_GWAS, "pheno_SNP_fixed.csv", row.names = FALSE)
write.csv(geno_final_GWAS_filt, "geno_SNP_fixed.csv", row.names = FALSE)

data <- read.GWASpoly(ploidy=4, 
                      pheno.file = "pheno_SNP_fixed.csv", 
                      geno.file = "geno_SNP_fixed.csv",
                      format="numeric", 
                      n.traits=1, 
                      delim=",")

# Create LOCO GRMs
data.loco <- set.K(data, LOCO=TRUE)

# Population size
N <- ncol(geno_final_GWAS_filt) - 3 

# Set params to specify fixed effects
params <- set.params(geno.freq = 1 - 5/N,
                     fixed = c("Cytoplasm","SNP_chr5_4091093"),
                     fixed.type = c("factor","factor"),
                     n.PC = 3)

# Testing markers for significance - GWASpoly conducts the hypothesis tests for each marker
data.loco.scan <- GWASpoly(data = data.loco,
                           models = c("additive"),
                           traits = c("RST"),
                           params = params)
save(data.loco.scan, file = "results/data.loco.scan_chr5_4091093.Rdata")

# Setting the Bonferroni threshold
data2 <- set.threshold(data.loco.scan,
                       method="Bonferroni",
                       level=0.05)

# Manhattan plot 
p <- manhattan.plot(data2, traits="RST")
manhattan_chr5_4091093_fixed <- p + theme(axis.text.x = element_text(angle=90,vjust=0.5))

png(filename = "plots/manhattan_chr5_4091093_fixed_additive.png", width = 800, height = 300)
plot(manhattan_chr5_4091093_fixed)
dev.off()

# QTL for the additive model
qtl <- get.QTL(data=data2, 
               traits="RST",
               models="additive",
               bp.window=5e6)
save(qtl, file = "results/QTL_fixed_chr5_4839577_additive.Rdata")

